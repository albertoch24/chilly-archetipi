# Copia questo file in .env e compila i valori.
# Senza le due variabili Supabase il sito parte in modalità dimostrativa (dati solo nel browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Namespace dei dati: tiene separato questo workshop dagli altri sullo stesso backend.
VITE_WORKSHOP_ID=chilly

# Facoltativi
VITE_WORKSHOP_DATE=
VITE_WORKSHOP_PASSWORD=
# Copia propria delle immagini del quiz (default: bucket pubblico del workshop Si Vola)
VITE_QUIZ_IMAGES_URL=
